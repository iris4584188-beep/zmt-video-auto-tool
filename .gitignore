# 环境变量（含 API Key）
.env

# 虚拟环境
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
